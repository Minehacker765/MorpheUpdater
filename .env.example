# Signing credentials used by morphe on every patch run.
KEYSTORE_PATH=release.keystore
KEYSTORE_PASSWORD=
KEYSTORE_ENTRY_ALIAS=
KEYSTORE_ENTRY_PASSWORD=
SIGNER_NAME=

# Alternative to KEYSTORE_PATH for CI: base64 of the keystore file,
# decoded to KEYSTORE_PATH at startup when that file is missing.
#   base64 -w0 release.keystore
#KEYSTORE_B64=

# Optional personal access token to raise GitHub API rate limits.
# CI uses the automatic GITHUB_TOKEN instead.
#GITHUB_TOKEN=
